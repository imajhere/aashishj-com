---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

/**
 * /decisions — public decision log.
 *
 * Each entry: title, date, what was considered, what was chosen, what would
 * change my mind. Modeled on engineering ADRs (Architecture Decision Records)
 * but for product/career/site choices.
 *
 * Aashish will rewrite the bodies in his voice. Titles + dates + considered/
 * chose/revisit fields are real — they happened during the foundation pass.
 *
 * To add a new entry: append to the `decisions` array below.
 * Sorted newest-first at render time.
 */

const decisions = [
  {
    date: '2026-04-30',
    title: 'Strip /projects back to Brain only',
    considered: 'Keep all three (Brain + 78 Labs + Team 78). Wider portfolio surface, shows range.',
    chose: 'Brain only. Side businesses fully invisible from this site.',
    revisitIf: 'I separate "currently evaluating roles" from "currently building" — then maybe the side businesses earn a slot.',
    placeholder: true,
  },
  {
    date: '2026-04-30',
    title: 'Live Brain status: real numbers + date stamp',
    considered: 'Fake "live" pulsing dot, true-live via Cloudflare Worker proxy, drop the framing entirely.',
    chose: 'Real values fetched at build time, "Tended <date>" stamp. No runtime dependency on the Mac Mini.',
    revisitIf: 'Visitor traffic justifies the Worker proxy cost (~2 hrs work) for true-live reads.',
    placeholder: true,
  },
  {
    date: '2026-04-29',
    title: 'Cut /fit and ask-AI-about-me',
    considered: 'Ship both as stubs ("Tool launching soon"). Demote /fit to a single email-capture page.',
    chose: 'Cut both entirely. No /fit route. The Brain System project page carries the AI flex on its own.',
    revisitIf: 'Hiring market shifts toward AI-feature-as-table-stakes, OR I find an AI feature that isn\'t a 2026 cliché.',
    placeholder: true,
  },
  {
    date: '2026-04-29',
    title: 'Public repo over private',
    considered: 'Keep aashishj-com private. Avoid placeholder-content embarrassment.',
    chose: 'Public. The site\'s own source code becomes part of the credibility story — peers can read how it\'s built.',
    revisitIf: 'I publish a post that needs a private staging period before going live.',
    placeholder: true,
  },
  {
    date: '2026-04-29',
    title: 'Skills page keeps the Gaps column',
    considered: 'Strip Gaps from the public surface (recruiter-rejection risk).',
    chose: 'Restored Gaps as first-class on /skills. Two columns on the homepage with a "what I\'m honest about not knowing →" link to /skills.',
    revisitIf: 'I get specific feedback that a Gap entry is reading as a false-disqualifier rather than an honest filter.',
    placeholder: true,
  },
];

// Sort newest-first
const sorted = decisions.slice().sort((a, b) => b.date.localeCompare(a.date));

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
};
---

<BaseLayout
  title="Decisions — Aashish Jagini"
  description="A public log of choices made on this site, on Brain, and on adjacent work. What I considered, what I chose, what would change my mind."
  current="decisions"
>
  <main id="main">

    <section class="min-h-[40vh] flex items-end pb-12">
      <div class="max-w-[1240px] mx-auto w-full px-6 lg:px-10 pt-20">
        <p class="kicker">DECISIONS · {sorted.length} entries · public log</p>
        <h1 class="h-display mt-6 text-[44px] sm:text-[60px] lg:text-[72px] max-w-[1100px]">
          What I <em>considered</em>, chose, and would revisit.
        </h1>
        <div class="mt-8 max-w-[640px]">
          <Placeholder size="lg">
            One paragraph of intro: why this page exists, what it is and isn't (it's not a changelog; it's a record of the decisions worth writing down). Aashish will rewrite.
          </Placeholder>
        </div>
      </div>
    </section>

    <hr class="editorial-rule" />

    <section class="py-16">
      <div class="max-w-[1240px] mx-auto px-6 lg:px-10">
        <div class="max-w-[760px]">
          {
            sorted.map((d) => (
              <article class="py-10 border-t border-line first:border-t-0">
                <p class="kicker">{fmtDate(d.date)}</p>
                <h2 class="font-serif text-[26px] sm:text-[30px] leading-[1.2] font-medium tracking-tight mt-3 mb-6">
                  {d.title}
                </h2>

                <dl class="space-y-5 mt-6">
                  <div>
                    <dt class="kicker mb-2">Considered</dt>
                    <dd>
                      {d.placeholder ? (
                        <Placeholder size="base">{d.considered}</Placeholder>
                      ) : (
                        <p class="text-[16.5px] leading-[1.6]">{d.considered}</p>
                      )}
                    </dd>
                  </div>

                  <div>
                    <dt class="kicker mb-2 text-burntdk">Chose</dt>
                    <dd>
                      {d.placeholder ? (
                        <Placeholder size="base">{d.chose}</Placeholder>
                      ) : (
                        <p class="text-[16.5px] leading-[1.6]">{d.chose}</p>
                      )}
                    </dd>
                  </div>

                  <div>
                    <dt class="kicker mb-2">Would revisit if</dt>
                    <dd>
                      {d.placeholder ? (
                        <Placeholder size="base" italic>{d.revisitIf}</Placeholder>
                      ) : (
                        <p class="text-[16.5px] leading-[1.6] italic text-muted">{d.revisitIf}</p>
                      )}
                    </dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="editorial-rule" />

    <section class="py-16 bg-cream">
      <div class="max-w-[1240px] mx-auto px-6 lg:px-10 max-w-[680px]">
        <p class="kicker">A note on this log</p>
        <div class="mt-6">
          <Placeholder size="lg" italic>
            Closing italic — what this page is for, what kinds of decisions earn a slot, what's deliberately omitted. Aashish will write.
          </Placeholder>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
