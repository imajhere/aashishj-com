---
import BaseLayout from '../layouts/BaseLayout.astro';

const strong = [
  'Enterprise PM at scale',
  'Spec-driven development with AI',
  'LLM product integration',
  'Cross-team leadership',
  'Building AI infra (MCP, RAG)',
];
const moderate = [
  'Frontend (React, Astro)',
  'Data engineering (SQL, Snowflake)',
  'Government IT procurement',
  'Brand voice and copywriting',
  'Technical writing for non-engineers',
];
const gaps = [
  'Mobile native (iOS/Android)',
  'Formal ML / model training',
  'Hardware design',
  'Game design',
  'Distributed systems at FAANG scale',
];
---

<BaseLayout
  title="Skills — Aashish Jagini"
  description="What I'm strong at, moderate at, and not at. The honest version, including the column most personal sites omit."
  current="skills"
>
  <main id="main">

    <section class="min-h-[42vh] flex items-end pb-12">
      <div class="max-w-[1240px] mx-auto w-full px-6 lg:px-10 pt-20">
        <p class="kicker">SKILLS · STRONG · MODERATE · GAPS</p>
        <h1 class="h-display mt-6 text-[44px] sm:text-[60px] lg:text-[72px] max-w-[1100px]">
          The <em>honest</em> version.
        </h1>
        <div class="mt-8 max-w-[640px]">
          <p class="text-[19px] leading-[1.7]">
            Everything below has evidence behind it. The third column — Gaps — is the one most sites leave out. I keep it because being hired into the wrong role costs far more than being passed over for it, for both sides.
          </p>
        </div>
      </div>
    </section>

    <hr class="editorial-rule" />

    <section class="py-20">
      <div class="max-w-[1240px] mx-auto px-6 lg:px-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-14">

        <div class="sk-col">
          <h3>Strong</h3>
          <ul>
            {strong.map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="sk-col">
          <h3>Moderate</h3>
          <ul>
            {moderate.map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="sk-col sk-gaps">
          <h3>Gaps</h3>
          <ul>
            {gaps.map((s) => <li>{s}</li>)}
          </ul>
        </div>

      </div>
    </section>

    <hr class="editorial-rule" />

    <section class="py-20 bg-cream">
      <div class="max-w-[1240px] mx-auto px-6 lg:px-10">
        <p class="kicker">A note on column III</p>
        <div class="mt-6 max-w-[680px]">
          <p class="text-[19px] leading-[1.7]">
            Most personal sites soften this column or drop it. I'd rather be legible. A short, honest list of what I don't do tells you more about what I do than another row of buzzwords would — and it means the conversations that start here tend to be the right ones.
          </p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
