---
import StatusLayout from '../../layouts/StatusLayout.astro';

const buildAt = new Date();
const lastBuildLocal = buildAt.toLocaleString('en-US', {
  timeZone: 'America/Chicago',
  dateStyle: 'medium',
  timeStyle: 'short',
});

// ============================================================
// At-a-glance — hardcoded snapshot. Rebuilds on every git push,
// so values reflect the state captured in the source at deploy
// time. For live freshness, BetterStack iframe below shows
// real-time HTTP probe results.
// ============================================================
const glance = [
  { label: 'Brain DB', value: '244 MB', sub: '4,729 chunks · 2,708 files' },
  { label: 'Doc-sweep', value: 'daily 02:00', sub: 'last full run 2026-04-30 · 2,494 docs' },
  { label: 'Active LaunchAgents', value: '21', sub: 'see § 6 in Overview' },
  { label: 'Backup chain', value: 'TM hourly · brain 5/6 AM', sub: 'all green' },
];

// ============================================================
// Quick links — daily-use launchpad. External services first,
// then internal LAN.
// ============================================================
const quickLinks = [
  { group: 'AI memory', items: [
    { name: 'Brain MCP (search via API)', url: 'https://brain.aashishj.com/health', meta: 'public health · MCP behind ?key=' },
    { name: 'Karakeep (bookmarks + notes)', url: 'https://mind.aashishj.com', meta: 'Cloudflare Tunnel · CF Access' },
  ]},
  { group: 'Family-facing sites', items: [
    { name: 'aashishj.com', url: 'https://aashishj.com/', meta: 'personal site' },
    { name: 'rishithajagini.com', url: 'https://rishithajagini.com/', meta: 'Rishitha’s portfolio' },
    { name: '78labs.in', url: 'https://78labs.in/', meta: '78 Labs storefront' },
    { name: 'team78.net', url: 'https://team78.net/', meta: 'team78 site' },
  ]},
  { group: 'Home services (LAN)', items: [
    { name: 'Home Assistant', url: 'http://192.168.1.199:8123', meta: '192.168.1.199' },
    { name: 'Plex', url: 'http://localhost:32400/web', meta: 'Mac Mini · port 32400' },
    { name: 'AdGuard Home', url: 'http://localhost', meta: 'Mac Mini · port 80' },
    { name: 'UniFi controller', url: 'https://unifi.ui.com', meta: 'UDM-SE' },
    { name: 'Synology NAS', url: 'http://192.168.1.19:5000', meta: '192.168.1.19 · DSM' },
  ]},
  { group: 'Code + monitoring', items: [
    { name: 'GitHub (imajhere)', url: 'https://github.com/imajhere', meta: 'all repos' },
    { name: 'BetterStack dashboard', url: 'https://uptime.betterstack.com/', meta: 'monitors + heartbeat' },
    { name: 'Cloudflare dashboard', url: 'https://dash.cloudflare.com/', meta: 'tunnel · DNS · Workers · Pages' },
    { name: '1Password', url: 'https://my.1password.com/', meta: 'family vault' },
  ]},
];

// ============================================================
// Services — major running pieces of the stack. Snapshot from
// Infrastructure Overview § 4 + § 5. Updated on each rebuild.
// ============================================================
const services = [
  {
    name: 'Brain MCP server',
    where: 'Mac Mini · com.brain.server',
    runtime: 'FastAPI + sentence-transformers (BGE) + SQLite (FTS5 + sqlite-vec)',
    purpose: 'Personal AI memory across vault + 2,400 OCR’d PDFs',
    monitor: 'BetterStack: brain.aashishj.com/health',
  },
  {
    name: 'Brain watcher',
    where: 'Mac Mini · com.brain.watcher',
    runtime: 'Python · watchdog PollingObserver',
    purpose: 'File-change incremental reindex of Obsidian vault',
    monitor: 'infra-healthcheck.sh: alerts if vectors.db mtime > 6h stale',
  },
  {
    name: 'Doc-sweep',
    where: 'Mac Mini · com.brain.doc-sweep-daily',
    runtime: 'Python · daily 02:00 · path-cache + /bin/cp staging (Gate D 2026-04-30)',
    purpose: 'OCR new OneDrive PDFs/images, extract metadata via local Ollama',
    monitor: 'HA push notification on every run with summary',
  },
  {
    name: 'Ollama (gemma2:9b)',
    where: 'Mac Mini · com.brain.ollama',
    runtime: 'localhost:11434',
    purpose: 'LLM for doc-sweep autotag (NOT used for search)',
    monitor: 'process status only',
  },
  {
    name: 'Karakeep',
    where: 'Mac Mini · OrbStack docker',
    runtime: 'web :3000 · meilisearch :7700 · SQLite',
    purpose: 'Bookmark manager (replaces MyMind subscription)',
    monitor: 'BetterStack: mind.aashishj.com',
  },
  {
    name: 'Plex Media Server',
    where: 'Mac Mini · :32400',
    runtime: 'native macOS app',
    purpose: 'Media server',
    monitor: 'infra-healthcheck.sh: HTTP probe to /identity',
  },
  {
    name: 'Scrypted',
    where: 'Mac Mini · native app',
    runtime: 'HomeKit camera bridge',
    purpose: 'Reolink + Ring → HomeKit',
    monitor: 'process status (planned: BetterStack monitor)',
  },
  {
    name: 'AdGuard Home',
    where: 'Mac Mini · LaunchDaemon · :80',
    runtime: 'native binary',
    purpose: 'Network-wide DNS ad-blocking (DHCP DNS via UDM-SE)',
    monitor: 'infra-healthcheck.sh: HTTP probe',
  },
  {
    name: 'Cloudflared tunnel',
    where: 'Mac Mini · com.brain.tunnel',
    runtime: 'cloudflared',
    purpose: 'brain.aashishj.com + mind.aashishj.com → Mac Mini',
    monitor: 'BetterStack via the public hostnames',
  },
  {
    name: 'Home Assistant',
    where: 'HA Green · 192.168.1.199',
    runtime: 'HAOS · Z-Wave + Matter + Thread + HomeKit',
    purpose: 'Smart-home automations · push notifications hub',
    monitor: 'infra-healthcheck.sh: HTTP probe',
  },
  {
    name: 'NAS docker (gluetun + *arr)',
    where: 'Synology NAS · 192.168.1.19',
    runtime: 'qBittorrent + gluetun (NordVPN) + Radarr + Sonarr + Prowlarr + flaresolverr',
    purpose: 'Media downloads via VPN',
    monitor: 'infra-healthcheck.sh: SSH + docker ps',
  },
];

// ============================================================
// Jobs — scheduled cron-like LaunchAgents, sorted by daily time.
// Match § 6 Master Jobs Table.
// ============================================================
const dailyJobs = [
  { time: '01:00', job: 'com.aashish.karakeep-backup', what: 'SQLite + meili dump + assets → NAS + GitHub' },
  { time: '02:00', job: 'com.aashish.scrypted-backup', what: 'tar.gz Scrypted app support → NAS' },
  { time: '02:00', job: 'com.brain.doc-sweep-daily', what: 'OCR new OneDrive docs (Gate D, was Sun-only until 2026-04-30)' },
  { time: '02:30', job: 'com.aashish.adguard-backup (root)', what: 'AdGuardHome.yaml → GitHub + NAS' },
  { time: '03:00', job: 'com.aashish.plex-backup', what: 'Plex metadata → NAS' },
  { time: '03:00', job: 'HA built-in backup', what: 'Full HA snapshot → NAS + OneDrive' },
  { time: '04:00', job: 'com.brain.logrotate', what: 'Truncate brain logs > 5MB' },
  { time: '04:15', job: 'com.aashish.launchagents-backup', what: 'rsync all plists → NAS' },
  { time: '04:30', job: 'com.brain.checkpoint', what: 'PRAGMA wal_checkpoint(TRUNCATE) on vectors.db (Gate B)' },
  { time: '05:00', job: 'com.brain.backup-db', what: 'sqlite3 .backup vectors.db → ~/Backups/brain-db/ (keep 7)' },
  { time: '06:00', job: 'com.aashish.brain-db-nas-backup', what: 'rsync ~/Backups/brain-db/ → NAS (Gate C, off-site)' },
];

const intervalJobs = [
  { interval: 'Hourly', job: 'Time Machine', what: 'macOS → NAS DriveSync · rotates automatically' },
  { interval: 'Hourly', job: 'com.aashish.karakeep-snapshot', what: 'Karakeep SQLite → local rolling 24' },
  { interval: 'Every 2h', job: 'com.aashish.obsidian-backup', what: 'rsync vault → git mirror → GitHub + NAS' },
  { interval: 'Every 2h', job: 'com.aashish.ha-backup', what: 'SSH rsync HA config → GitHub' },
  { interval: 'Every 10 min', job: 'com.aashish.ha-index', what: 'Regenerate HA System Index → vault' },
  { interval: 'Every 4h', job: 'infra-healthcheck.sh', what: 'Cron: probe services → HA push if any down + BetterStack heartbeat' },
  { interval: 'Every 3 min', job: 'BetterStack', what: 'External: probe 5 sites + receive heartbeat' },
  { interval: 'Continuous', job: 'com.brain.watcher', what: 'File-system watch → incremental reindex' },
];

// ============================================================
// Backup chain — match § 11 of Overview.
// ============================================================
const backups = [
  { what: 'Mac Mini full system', method: 'Time Machine (built-in)', dest: 'NAS DriveSync', schedule: 'hourly' },
  { what: 'Obsidian vault', method: 'rsync → git mirror → push', dest: 'GitHub: obsidian-vault + NAS', schedule: 'every 2h' },
  { what: 'HA config', method: 'SSH rsync → git push', dest: 'GitHub: homeassistant-config', schedule: 'every 2h' },
  { what: 'HA full snapshot', method: 'HA built-in', dest: 'NAS NFS + OneDrive (keep 7)', schedule: 'daily 03:00' },
  { what: 'Scrypted', method: 'tar.gz → rsync', dest: 'NAS /Backups/Scrypted/', schedule: 'daily 02:00' },
  { what: 'AdGuard config', method: 'git push + rsync', dest: 'GitHub: adguard-config + NAS', schedule: 'daily 02:30' },
  { what: 'Plex metadata', method: 'rsync', dest: 'NAS /Backups/Plex/ (~1GB)', schedule: 'daily 03:00' },
  { what: 'LaunchAgent plists', method: 'rsync', dest: 'NAS /Backups/MacMini-LaunchAgents/', schedule: 'daily 04:15' },
  { what: 'Brain vectors.db', method: 'sqlite3 .backup', dest: '~/Backups/brain-db/ (keep 7) → NAS /Backups/Brain/', schedule: 'daily 05:00 + 06:00 NAS mirror' },
  { what: 'Karakeep', method: 'stop-cp-start SQLite + meili dump + tar', dest: 'NAS /Backups/Karakeep/ + GitHub', schedule: 'daily 01:00 + hourly snapshot' },
];

// ============================================================
// Recent change log — last 4 entries from Infrastructure Overview
// § 16 (MANUALLY MIRRORED). When you add a row to § 16 in Obsidian
// and it's important enough to surface on this page, also update
// the array below + push aashishj-com to redeploy.
// (If this drift starts to bite, build the v2.5 auto-render — see
// § 13 of Overview for the deferred TODO.)
// ============================================================
const recentChanges = [
  { date: '2026-04-30', title: 'A5 + C6 done in parallel', detail: 'A5: Obsidian backup mmap deadlock fix (Gate D pattern, 122 previously-dropped files now in mirror). C6: HA index regen, event-driven (5 runs/day vs 144) via HA automation_reloaded → SSH → regen.' },
  { date: '2026-04-30', title: 'aashishj.com/status live (this page)', detail: 'Astro + Cloudflare Workers Static Assets + Worker auth (HTTP Basic Auth). CI deploys via wrangler-action with run_worker_first=true.' },
  { date: '2026-04-30', title: 'BetterStack monitoring + ntfy → HA push', detail: '6 monitors + heartbeat. UptimeRobot retired. 8 LaunchAgents archived. Doc-sweep notifications via HA push.' },
  { date: '2026-04-30', title: 'Brain Gates A-D', detail: 'SQLite hardening (busy_timeout + checkpoint + rollback + watcher self-heal). Doc-sweep OneDrive deadlock fixed: 2,494 files, 0 errno 11. Brain DB NAS off-site + restore drill.' },
];

// BetterStack public status page URL — embedded as iframe at top of page.
// Set 2026-04-30. To rotate / replace: BetterStack → Status pages →
// click the page → copy public URL → paste here → push.
const betterStackStatusUrl: string | null = 'https://jagini.betteruptime.com/';
---

<StatusLayout
  title="Infrastructure Status"
  lastBuildLocal={lastBuildLocal}
>
  <!-- ===== Live status ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Live status
    </h2>
    {betterStackStatusUrl ? (
      <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white">
        <iframe
          src={betterStackStatusUrl}
          class="h-[420px] w-full"
          loading="lazy"
          title="BetterStack live status"
        />
      </div>
    ) : (
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        <p class="font-mono text-xs uppercase">TODO</p>
        <p class="mt-1">
          Replace <code class="font-mono">betterStackStatusUrl</code> in
          <code class="font-mono"> src/pages/status/index.astro</code> with
          your BetterStack public page URL. Find it in BetterStack →
          Status pages → click the page → copy public URL.
        </p>
        <p class="mt-2">
          <a href="https://uptime.betterstack.com/" class="underline">
            Open BetterStack dashboard →
          </a>
        </p>
      </div>
    )}
  </section>

  <!-- ===== At a glance ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      At a glance
    </h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {glance.map((g) => (
        <div class="rounded-lg border border-zinc-200 bg-white p-4">
          <div class="text-xs uppercase tracking-wider text-zinc-500">{g.label}</div>
          <div class="mt-1 font-mono text-lg font-semibold text-zinc-900">{g.value}</div>
          <div class="mt-1 text-xs text-zinc-600">{g.sub}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Quick links ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Quick links
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {quickLinks.map((g) => (
        <div>
          <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-700">{g.group}</div>
          <ul class="space-y-1.5 border-l-2 border-zinc-200 pl-3">
            {g.items.map((it) => (
              <li>
                <a
                  href={it.url}
                  class="block rounded px-2 py-1 hover:bg-zinc-100"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="text-sm text-zinc-900">{it.name}</div>
                  <div class="font-mono text-xs text-zinc-500">{it.meta}</div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Services
    </h2>
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
      {services.map((s) => (
        <div class="rounded-lg border border-zinc-200 bg-white p-4">
          <div class="flex items-baseline justify-between gap-3">
            <div class="font-semibold text-zinc-900">{s.name}</div>
            <div class="font-mono text-xs text-zinc-500">{s.where}</div>
          </div>
          <div class="mt-1 text-sm text-zinc-700">{s.purpose}</div>
          <div class="mt-2 grid grid-cols-1 gap-1 text-xs sm:grid-cols-[80px_1fr]">
            <div class="text-zinc-500">Runtime</div>
            <div class="font-mono text-zinc-700">{s.runtime}</div>
            <div class="text-zinc-500">Monitor</div>
            <div class="font-mono text-zinc-700">{s.monitor}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Jobs ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Daily jobs
    </h2>
    <div class="overflow-x-auto rounded-lg border border-zinc-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="bg-zinc-50 text-xs uppercase text-zinc-500">
          <tr>
            <th class="px-4 py-2 font-medium">Time</th>
            <th class="px-4 py-2 font-medium">Job</th>
            <th class="px-4 py-2 font-medium">What</th>
          </tr>
        </thead>
        <tbody>
          {dailyJobs.map((j) => (
            <tr class="border-t border-zinc-100">
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs text-zinc-700">{j.time}</td>
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs text-zinc-900">{j.job}</td>
              <td class="px-4 py-2 text-xs text-zinc-700">{j.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mb-3 mt-8 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Interval jobs
    </h2>
    <div class="overflow-x-auto rounded-lg border border-zinc-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="bg-zinc-50 text-xs uppercase text-zinc-500">
          <tr>
            <th class="px-4 py-2 font-medium">Interval</th>
            <th class="px-4 py-2 font-medium">Job</th>
            <th class="px-4 py-2 font-medium">What</th>
          </tr>
        </thead>
        <tbody>
          {intervalJobs.map((j) => (
            <tr class="border-t border-zinc-100">
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs text-zinc-700">{j.interval}</td>
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs text-zinc-900">{j.job}</td>
              <td class="px-4 py-2 text-xs text-zinc-700">{j.what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===== Backups ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Backups
    </h2>
    <div class="overflow-x-auto rounded-lg border border-zinc-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="bg-zinc-50 text-xs uppercase text-zinc-500">
          <tr>
            <th class="px-4 py-2 font-medium">What</th>
            <th class="px-4 py-2 font-medium">Method</th>
            <th class="px-4 py-2 font-medium">Destination</th>
            <th class="px-4 py-2 font-medium">Schedule</th>
          </tr>
        </thead>
        <tbody>
          {backups.map((b) => (
            <tr class="border-t border-zinc-100">
              <td class="whitespace-nowrap px-4 py-2 text-xs font-medium text-zinc-900">{b.what}</td>
              <td class="px-4 py-2 text-xs text-zinc-700">{b.method}</td>
              <td class="px-4 py-2 font-mono text-xs text-zinc-700">{b.dest}</td>
              <td class="whitespace-nowrap px-4 py-2 font-mono text-xs text-zinc-700">{b.schedule}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===== Recent change log ===== -->
  <section class="mb-10">
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      Recent changes (last 4)
    </h2>
    <ol class="space-y-3">
      {recentChanges.map((c) => (
        <li class="rounded-lg border border-zinc-200 bg-white p-4">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs text-zinc-500">{c.date}</span>
            <span class="font-semibold text-zinc-900">{c.title}</span>
          </div>
          <p class="mt-1 text-sm text-zinc-700">{c.detail}</p>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-xs text-zinc-500">
      Full history: <code class="font-mono">02 Reference/Infrastructure Overview.md § 16</code> in Obsidian.
    </p>
  </section>
</StatusLayout>
