---
/**
 * ChapterCard.astro — one chapter on /experience.
 *
 * Renders real chapter copy: a one-paragraph "what shipped" summary and a
 * mono pull-quote (SHIPPED · X · LEARNED · Y). `summary` is plain text;
 * `pull` is an HTML string so the payload phrases can be <strong>-bolded.
 */
interface Props {
  /** Chapter ordinal — "I", "II", ... displayed as the kicker prefix. */
  ordinal: string;
  /** Year span as displayed (e.g. "2020 — present"). */
  years: string;
  /** Location chip (e.g. "Frisco, TX"). */
  location: string;
  /** Org / role label inside the role-name italics (e.g. "McKinsey · Platform"). */
  org: string;
  /** Headline title (e.g. "Senior Product Manager"). */
  title: string;
  /** One-paragraph "what shipped" summary (plain text). */
  summary: string;
  /** Mono pull-quote as HTML (e.g. "SHIPPED · <strong>X</strong> · LEARNED · <strong>Y</strong>"). */
  pull?: string;
  /** Eyebrow before the title. Defaults to "Chapter {ordinal}". */
  eyebrow?: string;
}

const { ordinal, years, location, org, title, summary, pull, eyebrow } = Astro.props;
const computedEyebrow = eyebrow ?? `CHAPTER ${ordinal}`;
---

<article class="py-14 border-t border-line first:border-t-0">
  <div class="grid grid-cols-12 gap-6 lg:gap-10">
    <div class="col-span-12 lg:col-span-3">
      <div class="kicker">{computedEyebrow}</div>
      <div class="ui mt-3 text-[14px]">{years}</div>
      <div class="ui mt-1 text-[13px] text-muted">{location}</div>
    </div>

    <div class="col-span-12 lg:col-span-9 max-w-[720px]">
      <h2 class="font-serif text-[28px] sm:text-[34px] leading-[1.15] font-medium tracking-tight">
        {title} <span class="italic font-normal text-muted">— {org}</span>
      </h2>

      <div class="mt-6 space-y-5">
        <p class="text-[19px] leading-[1.7]">{summary}</p>
        {pull && <p class="pull" set:html={pull} />}
      </div>
    </div>
  </div>
</article>
