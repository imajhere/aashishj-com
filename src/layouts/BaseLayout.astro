---
/**
 * BaseLayout.astro — site shell.
 *
 * Every page renders inside this. Owns:
 *   - <head> (title, description, canonical, OG/Twitter, JSON-LD)
 *   - global styles + fonts
 *   - skip-link, header, command palette, footer
 *   - theme-toggle script (vanilla — no React island in this pass)
 *   - Astro view transitions (soft cross-fade on navigation)
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'experience' | 'projects' | 'skills' | 'fit' | 'writing';
  /** Use floating (absolute) header on the homepage; bordered on inner pages. */
  floatingHeader?: boolean;
  /** OG image — defaults to /og-default.png. Pass a per-page override if available. */
  ogImage?: string;
  /** Page-level structured data (Article, CreativeWork, etc.) — JSON-LD object. */
  schema?: Record<string, unknown>;
  /** Override og:type. Default `profile` on /, `website` elsewhere. */
  ogType?: string;
}

const {
  title,
  description,
  current = 'home',
  floatingHeader = false,
  ogImage = '/og-default.png',
  schema,
  ogType = current === 'home' ? 'profile' : 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Site-wide Person + ProfilePage. Always emitted on /, available everywhere
// for cross-page entity references via @id.
const personGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://aashishj.com/#person',
      name: 'Aashish Jagini',
      givenName: 'Aashish',
      familyName: 'Jagini',
      url: 'https://aashishj.com',
      email: 'aashish@aashishj.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Frisco',
        addressRegion: 'TX',
        addressCountry: 'US',
      },
      sameAs: [
        'https://www.linkedin.com/in/aashishjagini',
        'https://github.com/aashishjagini',
        'https://x.com/aashishjagini',
      ],
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://aashishj.com/#profile',
      mainEntity: { '@id': 'https://aashishj.com/#person' },
      url: 'https://aashishj.com',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Writing — Aashish Jagini" href="/writing/rss.xml" />

    <!-- OG / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    {ogType === 'profile' && (
      <>
        <meta property="profile:first_name" content="Aashish" />
        <meta property="profile:last_name" content="Jagini" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@aashishjagini" />

    <!-- JSON-LD: Person + ProfilePage on every page (entity graph) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personGraph)} />

    <!-- Page-level schema if provided -->
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Theme: read stored preference before paint to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const initial = stored || (sysDark ? 'dark' : 'light');
          if (initial === 'dark') document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="min-h-screen">
    <a href="#main" class="skip-link">Skip to main content</a>

    <Header current={current} floating={floatingHeader} />

    <slot />

    <Footer />

    <CommandPalette />

    <!-- Theme toggle wiring (works with the inline pre-paint script above) -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        function syncIcons() {
          const dark = root.classList.contains('dark');
          const m = document.getElementById('icon-moon');
          const s = document.getElementById('icon-sun');
          if (m) m.classList.toggle('hidden', !dark);
          if (s) s.classList.toggle('hidden', dark);
        }
        function bindToggle() {
          const btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            root.classList.toggle('dark');
            try {
              localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
            } catch (_) {}
            syncIcons();
          });
        }
        syncIcons();
        bindToggle();
        document.addEventListener('astro:page-load', function () {
          syncIcons();
          bindToggle();
        });
      })();
    </script>
  </body>
</html>
