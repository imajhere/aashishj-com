---
/**
 * StatusLayout.astro — minimal shell for /status (private dashboard).
 *
 * No public nav, no Header/Footer/CommandPalette — those belong to
 * the public site. This page is gated and utilitarian.
 */
import '../styles/global.css';

interface Props {
  title: string;
  lastBuildLocal: string;
}
const { title, lastBuildLocal } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-zinc-50 text-zinc-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title} · aashishj.com</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="font-sans antialiased">
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
      <header class="mb-8 border-b border-zinc-200 pb-6">
        <div class="flex items-baseline justify-between gap-4">
          <h1 class="font-mono text-xl font-bold tracking-tight sm:text-2xl">
            AJ Infrastructure
          </h1>
          <a
            href="/"
            class="text-xs text-zinc-500 hover:text-zinc-900 hover:underline"
          >
            ← aashishj.com
          </a>
        </div>
        <p class="mt-1 text-xs text-zinc-500">
          Auto-deploys on push to aashishj-com · Built {lastBuildLocal} CDT
        </p>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-12 border-t border-zinc-200 pt-4 text-xs text-zinc-400">
        <p>Single source of truth for ops state lives in <code class="font-mono">02 Reference/Infrastructure Overview.md</code> in the Obsidian vault. Edit there, this page rebuilds on next push.</p>
      </footer>
    </div>
  </body>
</html>
